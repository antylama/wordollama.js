{
  "name": "wordollama-dev-launcher",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node start-dev.mjs",
    "build:local": "node scripts/build-local.mjs",
    "build:public": "node scripts/build-local.mjs public",
    "start:local": "dotnet dist-local/WordOllama.DesktopBridge.dll",
    "start:public": "dotnet dist-local/WordOllama.DesktopBridge.dll --Bridge:Urls=http://0.0.0.0:37421 --Bridge:AllowRemoteAccess=true",
    "icons:generate": "npm --prefix officejs/apps/addin run icons:generate"
  }
}
