# Public HTTPS origin where the Word add-in is hosted (used by npm run manifest:zip and build:local)
WORDOLLAMA_ADDIN_URL=https://word.example.com
# Optional: listen on all interfaces (or pass --public to npm run build:local -- --public)
# WORDOLLAMA_LISTEN_URL=http://0.0.0.0:37421
# WORDOLLAMA_ALLOW_REMOTE=1
# Optional overrides:
# WORDOLLAMA_APP_ID=9f8e6b40-3c1f-4e7b-9a2d-5e1c8a7b4f01
# WORDOLLAMA_DEVELOPER_NAME=WordOllama.JS
